# No API key needed! mycode uses Ollama (local LLM) by default.
# Ollama runs free on your machine at http://localhost:11434
#
# To change the model, edit mycode.config.json:
#   "model": "llama3.1"        ← best general purpose
#   "model": "mistral"         ← fast
#   "model": "codellama"       ← code-focused
#   "model": "deepseek-coder"  ← strong code model
